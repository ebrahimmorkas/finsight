# Copy to .env and adjust. Every value has a sensible default for local development.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite.
# Example: postgres://finsight:finsight@localhost:5432/finsight
DATABASE_URL=

# Optional. When set, Redis backs the cache and the Celery broker. When empty,
# FinSight uses an in-memory cache and runs Celery tasks synchronously.
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FinSight <no-reply@finsight.local>
SITE_URL=http://localhost:8000
